
# Chapter 13, tier 3: the game's numbers, sent to InfluxDB on the control host over the private network.
# The profiler measures; Metrics_InfluxDB sends what it measured, once a second, over UDP.
NWNX_PROFILER_SKIP=n
NWNX_METRICS_INFLUXDB_SKIP=n
NWNX_METRICS_INFLUXDB_HOST=10.77.0.1
NWNX_METRICS_INFLUXDB_PORT=8089
# Each database query's time, as NWNX_SQL.SQLQueries (needs NWNX_SQL, chapter 5).
NWNX_SQL_QUERY_METRICS=y
# A stall of the game's main loop for this many seconds is logged and counted as a LongStall.
NWNX_THREADWATCHDOG_SKIP=n
NWNX_THREADWATCHDOG_PERIOD=15
# The game's own log, which otherwise only goes to logs/nwserverLog1.txt, also into the container's log,
# so it reaches Loki with everything else.
NWNX_SERVERLOGREDIRECTOR_SKIP=n
