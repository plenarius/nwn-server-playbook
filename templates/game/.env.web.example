
# ---- Custom content for players (chapter 7). Add these lines to the end of .env, ----
# ---- and delete the earlier COMPOSE_FILE line above them.                         ----

# Use all three Compose files from now on.
COMPOSE_FILE=compose.yaml:compose.db.yaml:compose.web.yaml

# The name players' games download from. It must point at this machine (chapter 2).
NWSYNC_HOST=nwsync.example.org
# What the game server tells players' games. The same name, with https:// in front.
NWN_NWSYNCURL=https://nwsync.example.org
