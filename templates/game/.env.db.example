
# ---- The database (chapter 5). Add these lines to the end of .env. ----

# Use both Compose files from now on.
COMPOSE_FILE=compose.yaml:compose.db.yaml

# The NWNX plugin that lets scripts talk to the database, and where the database is.
# "mariadb" is the database container's name on Docker's own network.
NWNX_SQL_SKIP=n
NWNX_SQL_TYPE=mysql
NWNX_SQL_HOST=mariadb
NWNX_SQL_DATABASE=nwn
NWNX_SQL_USERNAME=nwn
# The game's database password. Neither server will start until it is set.
NWNX_SQL_PASSWORD=

# Lets a line typed at the server's console call NWNX, which the chapter's check uses.
NWNX_CORE_ALLOW_NWNX_FUNCTIONS_IN_EXECUTE_SCRIPT_CHUNK=true
