# The database's own administrator password. Copy this file to db.env, set the password, keep it to yourself:
#   cp db.env.example db.env && chmod 600 db.env
#
# It is in a file of its own so that the game server never sees it. The game has its own, smaller account,
# set in .env. This password is read once, the first time the database starts. Changing it here later
# does not change it in the database.
MARIADB_ROOT_PASSWORD=
# The administrator may only log in from inside the database's own container.
MARIADB_ROOT_HOST=localhost
