# Settings for the game server. Copy this file to .env, fill it in, and keep .env to yourself:
#   cp .env.example .env && chmod 600 .env

# The image. A commit tag (seven letters and digits) never changes, so the server moves to a new
# version only when you change this line. The chapter shows how to find the tag for your game build.
NWNX_IMAGE=nwnxee/unified:ed79330

# The game
NWN_PORT=5121
NWN_SERVERNAME=My new server
NWN_MODULE=DockerDemo
NWN_MAXCLIENTS=16
# 1 lists the server in the game's public server list, 0 keeps it unlisted.
NWN_PUBLICSERVER=0

# Passwords. The server will not start until the DM and admin passwords are set.
# Leave the player password empty for a server anyone may join.
NWN_PLAYERPASSWORD=
NWN_DMPASSWORD=
NWN_ADMINPASSWORD=

# NWNX plugins. Every plugin is off until it is switched on here, one line each:
#   NWNX_<NAME>_SKIP=n
# Switch a plugin on when your module's scripts include its nwnx_*.nss file.
NWNX_UTIL_SKIP=n
