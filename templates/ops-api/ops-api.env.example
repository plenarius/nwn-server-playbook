# The operations API's settings for this guide's tier 2 (chapter 9). They go into the Coolify service's
# Environment variables (Developer View takes them as they are), not into a file on the control host.
# Keep a written copy, as chapter 3 suggests, but keep the keys and tokens in your password manager.
# The full list of settings, with what each does, is in nwn-ops-api's README and .env.example.

# --- The image you built (chapter 9, step 3), and where the API listens -------------------------------------------
OPS_API_IMAGE=nwn-ops-api:COMMIT
OPS_API_BIND=10.77.0.1

# --- Keys: each `openssl rand -hex 32`, all different -----------------------------------------------------------
# full: in your password manager only, for the day the others are lost
OPS_API_KEY=
# admin: you and your own tools (stop, start, deploys, NWNX updates, releases)
OPS_API_ADMIN_KEY=
# team: your staff's bot or page (what read opens, plus logs, restart and cancelling a restart)
OPS_API_TEAM_KEY=
# read: your website's status page (status, modules, progress without the log; nothing that changes the game)
OPS_API_READ_KEY=

# --- The game host --------------------------------------------------------------------------------------------
GAME_HOST=10.77.0.2
SSH_USER=nwn
# The game's folders were made with sudo in tier 1, so the API moves files with sudo -n.
SSH_SUDO=true
GAME_DIR=/home/nwn/game
# Coolify's own copy of the game service's settings on the game host, kept in step with NWN_MODULE at a deploy.
COOLIFY_ENV_FILE=/data/coolify/services/GAME_SERVICE_UUID/.env
# Back up the database while the game is stopped for a deploy (chapter 12's backup script).
DEPLOY_HOOK=/home/nwn/game/backup.sh

# --- Coolify: the game as a Coolify service (chapter 4, tier 2) --------------------------------------------------
COOLIFY_API_URL=http://10.77.0.1:8000
COOLIFY_TOKEN=
COOLIFY_SERVICE_UUID=GAME_SERVICE_UUID

# --- NWNX: the same moving tag as the game's own NWNX_IMAGE (chapter 9, step 11) ---------------------------------
NWNX_IMAGE=nwnxee/unified:build8193.37.17

# --- Redis: only once your module handles the restart command (chapter 9, step 9) --------------------------------
# REDIS_URL=redis://:REDIS_PASSWORD@10.77.0.2:6379
# REDIS_PREFIX=nwn:

# --- GitHub releases (chapter 9, step 12) -----------------------------------------------------------------------
# A fine-grained token for these repositories only: Contents read and write, Pull requests and Actions read.
# GITHUB_TOKEN=
# REPOS=module=you/mymodule@main,haks=you/myhaks@main

# --- Discord notices (chapter 9, step 13) -----------------------------------------------------------------------
# DISCORD_WEBHOOK_URL=
# SERVER_NAME=My new server
# DISCORD_USERNAME=My new server
