#!/bin/sh
# git-credential-agent: a git credential helper that hands git a token from the agent's secrets file, chosen
# by the repository's address. Chapter 15, tier 3.
#
# Install for the agent user (setup-worker.sh does):
#   git config --global credential.helper ~/.local/bin/git-credential-agent
#   git config --global credential.useHttpPath true      (so git tells it the repository, not only the host)
# Settings:
#   ~/.config/agent/tokens.map   lines "host/owner/ VARIABLE": the first line whose start matches the
#                                address wins, so put the most specific first
#   AGENT_SECRETS                the secrets file, KEY=value lines (default /run/agent/secrets.env)
# Only "get" is answered: git can't store or erase anything through it. The token is never written anywhere.
[ "$1" = get ] || exit 0
secrets=${AGENT_SECRETS:-/run/agent/secrets.env}
map=${AGENT_TOKEN_MAP:-$HOME/.config/agent/tokens.map}
[ -r "$secrets" ] && [ -r "$map" ] || exit 0
host= path=
while IFS='=' read -r k v; do
  [ -z "$k" ] && break
  case $k in host) host=$v ;; path) path=$v ;; esac
done
want="$host/$path"
var=$(while read -r prefix name; do
  case $prefix in ''|'#'*) continue ;; esac
  case $want in "$prefix"*) echo "$name"; break ;; esac
done < "$map")
[ -n "$var" ] || exit 0
tok=$(sed -n "s/^$var=//p" "$secrets" | head -1 | sed "s/^[\"']//; s/[\"']\$//")
[ -n "$tok" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$tok"
