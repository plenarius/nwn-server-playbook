# Settings for setup-worker.sh. Copy to worker.env beside it and change what you need. No secrets in here.

# The account your agents run as. No sudo, not in the docker group, no SSH login of its own.
AGENT_USER=agent

# The fence around everything that account runs (systemd's user-<uid>.slice). Leave at least a third of the
# machine for whatever else runs there. MemoryMax is the wall: past it, the kernel stops the biggest process in
# the slice, and everything else in it carries on. CPUQuota is in percent of one core: 200% is two cores.
MEM_MAX=6G
# How much of the host's swap the agents may use. Without a limit, a runaway job fills all of it first, and the
# wall is only reached once swap is full, slowly.
MEM_SWAP_MAX=1G
# MemoryHigh slows down every process in the slice once it is passed, the agent server included: in our test
# the server stopped answering while one runaway job sat above it. So leave it at infinity, and let agents
# fence their own big jobs (systemd-run --user --scope -p MemoryMax=...), as their guide says.
MEM_HIGH=infinity
CPU_QUOTA=300%
TASKS_MAX=4096

# Memory the agent server itself keeps however hard its agents push (MemoryLow). Set on the server's own
# unit and on every parent above it, or it does nothing.
SERVER_MEMORY_LOW=1536M
PARENT_MEMORY_LOW=2G

# The user unit that runs your agent tool's server (T3 Code's installer writes t3code.service).
AGENT_SERVICE=t3code.service

# Where the agents' scratch lives, as a pattern with {uid}. Claude Code writes to /tmp/claude-<uid>. On a
# machine where /tmp is a tmpfs, that is memory.
SCRATCH=/tmp/claude-{uid}
# The cleaner keeps anything changed in the last KEEP_MIN minutes, and any folder named in a running
# process's command line.
KEEP_MIN=120
