{
  "defaultAutoPull": true,
  "projectSettingsFolded": true,
  "idleCompaction": "onReturn",
  "linkedEnvironmentsEnabled": true,
  "workflowsEnabled": true,
  "promptSuggestionsEnabled": true,
  "sidebarAutoSettleOnMerge": false,
  "removeAgentCreditsOnMerge": true,
  "providerInstances": {
    "claude-world": {
      "driver": "claudeAgent",
      "displayName": "Claude (our world)",
      "config": { "homePath": "/home/you/.claude-world" },
      "environment": [
        { "name": "CLAUDE_CODE_OAUTH_TOKEN", "value": "PUT-YOUR-TOKEN-HERE-AND-NEVER-COMMIT-THIS-FILE", "sensitive": true }
      ]
    }
  },
  "defaultModelSelection": { "instanceId": "claude-world", "model": "claude-opus-5-5" }
}
