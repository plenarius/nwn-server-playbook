# Settings for agent-docs-push. Copy to ~/.config/agent-docs/agent-docs.env. KEY=value lines; $HOME and a
# leading ~/ are expanded. No secrets. Chapter 15, tier 3.

# Where common.md, probe.sh and one <machine>.md per worker are; where every build is written (read it first).
TEMPLATES=~/.config/agent-docs
OUT=~/.cache/agent-docs

# Your own rules file on the hub, and the "## " sections of it that every worker gets, separated by |.
RULES=~/.config/agent-docs/hub-rules.md
SECTIONS="People decide|Pull requests|Repositories"

# Where the guide goes under the agent user's home: one path per agent tool you run there.
GUIDE_FILES=".claude/CLAUDE.md AGENTS.md"

# The workers, by key. For each: its name in the guide, how to reach it, how to become the agent user there,
# and the agent user's home as the worker's shell writes it.
MACHINES="worker1"
WORKER1_NAME=worker1
WORKER1_SSH="ssh -o BatchMode=yes admin@10.77.0.4"
WORKER1_AS="sudo -u agent"
WORKER1_HOME="~agent"

# What the probe looks for: commands, and data folders (~ is the agent user's home).
PROBE_TOOLS="git python3 node gh docker nasher nwn_script_comp"
PROBE_DATA="/srv/game ~/data"
