# One file per worker: ~/.config/agent-tunnels/NAME.env, read by agent-tunnel@NAME. Chapter 15, tier 3.
# Who to log in as on the worker: your own admin account there, not the agent's (the agent account has no SSH).
SSH_TARGET=admin@10.77.0.4
# The port on this hub that reaches the worker's agent server: one per worker, pick any free one.
LOCAL_PORT=37736
# The agent server's port on the worker's loopback (T3 Code: 3773).
REMOTE_PORT=3773
# Anything else for ssh, e.g. -i ~/.ssh/id_ed25519 -o IdentitiesOnly=yes
SSH_OPTS=
