# Settings for burst.sh. Copy to ~/.config/agent-burst/burst.env on the hub. Bash syntax. No secrets: only the
# path of the file that holds the token. Chapter 15, tier 3.

# The provider project for burst servers, and its token (chapter 1, tier 3: a project of its own).
HCLOUD_TOKEN_FILE=~/.config/hcloud/burst.token
# hcloud-servers (chapter 1, tier 3) makes and deletes the servers; these are its own settings.
MANAGED_BY=burst
SSH_KEYS=hub-key
MAX_HOURS=6
BUDGET_EUR=10
EXTRA_LABELS=role=burst
# Your key for root on the new servers, and a known_hosts file of their own (addresses get reused).
SSH_KEY=~/.ssh/id_ed25519
KNOWN_HOSTS=~/.config/agent-burst/known_hosts
# Where "collect" puts what the agents left in /srv/burst-out, one folder per server and start time.
OUT_DIR=~/burst-out
# Minutes before the end that the server warns everyone logged in (wall) and writes /run/burst/warning.
WARN_MIN="15 5"
# Minutes before the end that the hub copies /srv/burst-out here by itself (a timer on the hub). Empty: off.
COLLECT_MIN="10 2"
