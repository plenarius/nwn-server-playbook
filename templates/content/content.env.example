# Settings for publish.sh, promote.sh and prune.sh (chapter 7, tier 2). Copy to ~/content/content.env and change
# the first line. Every other line shows its default; the scripts work without them.

# The address players' games download from, as the game server is told it.
NWSYNC_URL=https://nwsync.example.org

# CONTENT_DIR=$HOME/myhaks       your content repository, cloned on this machine
# NWSYNC_DIR=$HOME/nwsync        the folder the downloads service serves
# GAME=10.77.0.2                 the game host's private address
# GAME_USER=nwn                  the deploy user there
# GAME_DIR=game                  the game folder there, holding release.sh
# STAGING_DIR=staging            the staging copy's folder there (chapter 6); publish.sh gives it the new content
# IMAGE=nwsync-builder:2.3.2     the builder image (builder/Dockerfile)
# BUILD_CPUS=1                   how much of this machine a build may use, so Coolify stays responsive
# BUILD_MEMORY=1g
# KEEP=3                         how many of the newest versions the tidy-up always keeps
# MIN_AGE_DAYS=7                 and nothing younger than this
