# Copies the character vault into its history and pushes it. Installed by chapter 12, tier 3; started by vault-history.timer.
[Unit]
Description=Commit the character vault's changes to its history (chapter 12, tier 3)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/nwn-vault-history
TimeoutStartSec=20min
Nice=10
IOSchedulingClass=idle
