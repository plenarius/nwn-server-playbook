# Starts borg-backup.service once a night. Times are in UTC, the server's clock since chapter 1.
# Half an hour after tier 1's local backup, so the two don't share the disk.
[Unit]
Description=Nightly off-site borg backup

[Timer]
OnCalendar=*-*-* 09:30:00
# Up to ten minutes of spread, and a run after boot if the machine was off at the usual time.
RandomizedDelaySec=600
Persistent=true

[Install]
WantedBy=timers.target
