# The bot's settings (chapter 10). In Coolify they go into the application's Environment variables; for plain
# Docker Compose, copy this file to .env (chmod 600) and fill it in. Keep the token and the keys in your password
# manager as well.

# --- Discord --------------------------------------------------------------------------------------------------
# The bot's token, from the Developer Portal (Bot, Reset Token). Anyone with it *is* your bot.
DISCORD_TOKEN=
# Your Discord server's id, and the ids of the two channels and the staff role (Developer Mode on, then right-click,
# Copy ID). The dashboard channel is one the bot posts in and nobody else does.
GUILD_ID=
DASHBOARD_CHANNEL_ID=
CHANGELOG_CHANNEL_ID=
# Members with this role may press Restart and Cancel restart, and use /restart and /cancel-restart.
STAFF_ROLE_ID=
# The dashboard's title.
SERVER_NAME=My new server
# Seconds between dashboard edits (30 at least).
# REFRESH_SECONDS=60
# Send the bot's two commands to Discord when it starts. This REPLACES every command the same application has in
# your server: turn it off if this token also runs another bot program.
# SYNC_COMMANDS=true
# false: log in, post and edit the dashboard and the changelog, and nothing else: no buttons, no commands, no
# connection to Discord's live event stream. For trying the bot on a token another program already uses.
# DISCORD_GATEWAY=true

# --- The operations API (chapter 9) ------------------------------------------------------------------------------
# Over the private network. The team key is all the bot needs: status, restart and cancelling a restart.
OPS_API_URL=http://10.77.0.1:8100
OPS_API_KEY=

# --- The changelog: GitHub's webhook -------------------------------------------------------------------------------
# The secret you also type into each repository's webhook: `openssl rand -hex 32`.
GITHUB_WEBHOOK_SECRET=
# Only these repositories (owner/name, comma separated); empty takes every repository whose webhook has the secret.
# CHANGELOG_REPOS=you/mymodule,you/myhaks
# A pull request with this label gets no post.
# CHANGELOG_SKIP_LABEL=no-changelog
# The port the receiver listens on inside the container.
# WEBHOOK_PORT=9090
