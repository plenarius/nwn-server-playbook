CREATE DATABASE nwn WITH DURATION 14d SHARD DURATION 1d NAME raw; CREATE RETENTION POLICY rollup_1m ON nwn DURATION 180d REPLICATION 1 SHARD DURATION 7d; CREATE CONTINUOUS QUERY cq_tickrate_1m ON nwn BEGIN SELECT min("Count") AS "min", mean("Count") AS "mean" INTO nwn.rollup_1m.tickrate FROM nwn.raw."NWNX_Profiler.GameTickRate" GROUP BY time(1m) END; CREATE CONTINUOUS QUERY cq_scripts_1m ON nwn BEGIN SELECT sum("ns") AS "ns_sum", max("ns") AS "ns_max", count("ns") AS "n" INTO nwn.rollup_1m.timing_by_script FROM nwn.raw."NWNX_Profiler.TimingEvent" GROUP BY time(1m), "EventName", "Script" END
